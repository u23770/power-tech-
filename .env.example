# POWER TECH — environment reference. Copy to .env.local for YOUR OWN notes or local tooling only.
# The static site has NO build step and does not read this file. Browser values live in shared/config.js.
#
# ---- Public values (safe in the browser; still copy them into shared/config.js) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SITE_ORIGIN=https://YOUR-DOMAIN.example

# ---- Server-side secrets (NEVER in browser code, shared/config.js, the repo, or Vercel client variables) ----
# Service-role key bypasses RLS. Use only in trusted local/CI maintenance scripts, if at all.
# SUPABASE_SERVICE_ROLE_KEY=
# Local test database only (tests/reset_local_test_db.sh). Never point at production.
# TEST_DATABASE_URL=postgres://postgres@/pt_test?host=/tmp

# ---- Access-code-only admin session (set these in Vercel server-side environment variables) ----
# SUPABASE_URL and SUPABASE_ANON_KEY above are also required by the server endpoint.
ADMIN_ACCESS_CODE=choose-a-long-random-code
ADMIN_SESSION_SECRET=choose-a-different-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
